generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InquiryStatus {
  NEW
  PROCESSING
  CLOSED
}

model Category {
  id          String       @id @default(cuid())
  nameZh      String
  nameEn      String
  slug        String       @unique
  parentId    String?
  parent      Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]   @relation("CategoryTree")
  coverImage  String?
  sortOrder   Int          @default(0)
  status      PublishStatus @default(PUBLISHED)
  products    Product[]
  articles    Article[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([parentId, sortOrder])
  @@index([status, sortOrder])
}

model Product {
  id          String       @id @default(cuid())
  nameZh      String
  nameEn      String
  slug        String       @unique
  categoryId  String
  category    Category     @relation(fields: [categoryId], references: [id])
  model       String
  materialZh  String
  materialEn  String
  finishZh    String
  finishEn    String
  summaryZh   String       @db.Text
  summaryEn   String       @db.Text
  coverImage  String
  gallery     Json?
  status      PublishStatus @default(DRAFT)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([categoryId, status, sortOrder])
}

model Article {
  id          String       @id @default(cuid())
  titleZh     String
  titleEn     String
  slug        String       @unique
  categoryId  String
  category    Category     @relation(fields: [categoryId], references: [id])
  summaryZh   String       @db.Text
  summaryEn   String       @db.Text
  contentZh   String       @db.LongText
  contentEn   String       @db.LongText
  coverImage  String
  publishedAt DateTime?
  status      PublishStatus @default(DRAFT)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([categoryId, status, publishedAt])
}

model CaseStudy {
  id               String       @id @default(cuid())
  titleZh          String
  titleEn          String
  slug             String       @unique
  categoryId       String
  category         Category     @relation(fields: [categoryId], references: [id])
  summaryZh        String       @db.Text
  summaryEn        String       @db.Text
  contentZh        String       @db.LongText
  contentEn        String       @db.LongText
  projectTypeZh    String
  projectTypeEn    String
  locationZh       String
  locationEn       String
  suppliedProductsZh String
  suppliedProductsEn String
  coverImage       String
  gallery          Json?
  publishedAt      DateTime?
  status           PublishStatus @default(DRAFT)
  sortOrder        Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([categoryId, status, sortOrder])
}

model HomeHeroSlide {
  id             String       @id @default(cuid())
  categoryZh     String
  categoryEn     String
  titleLeadZh    String       @db.Text
  titleLeadEn    String       @db.Text
  titleEmphasisZh String
  titleEmphasisEn String
  summaryZh      String       @db.Text
  summaryEn      String       @db.Text
  image          String
  primaryLabelZh String
  primaryLabelEn String
  primaryTo      String
  secondaryLabelZh String
  secondaryLabelEn String
  meta           Json
  sortOrder      Int          @default(0)
  status         PublishStatus @default(PUBLISHED)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, sortOrder])
}

model MediaAsset {
  id          String   @id @default(cuid())
  url         String
  filename    String
  altZh       String
  altEn       String
  mimeType    String
  size        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Inquiry {
  id          String        @id @default(cuid())
  name        String
  company     String
  email       String
  phone       String?
  interest    String
  message     String        @db.Text
  source      String
  status      InquiryStatus @default(NEW)
  internalNote String?      @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
}

model SiteSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

