# MySQL connection used by Prisma when persistence is enabled.
DATABASE_URL="mysql://username:password@127.0.0.1:3306/hongcai_wanfu"

# Set this before enabling the admin console in production.
NUXT_SESSION_SECRET="replace-with-a-long-random-value"

# Admin session cookie only over HTTPS. Default is to require HTTPS in production.
# Set to "false" ONLY while the domain has no certificate yet (e.g. during ICP filing),
# and remove it once HTTPS is enabled — otherwise the admin password and session
# cookie travel over plain HTTP.
# NUXT_COOKIE_SECURE="false"

# Used only to create the first administrator when admin_users is empty.
# Keep ADMIN_PASSWORD on the server; it is never sent to the browser.
ADMIN_USERNAME="site-admin"
ADMIN_PASSWORD="replace-with-a-unique-password-of-at-least-12-characters"

# Baidu Translate Open Platform: General Text Translation API.
BAIDU_TRANSLATE_APP_ID="your-app-id"
BAIDU_TRANSLATE_SECRET_KEY="your-secret-key"

# AMap JS API 2.0 (Web端 JS API). Keep the security code aligned with the key.
NUXT_PUBLIC_AMAP_KEY="your-amap-web-key"
NUXT_PUBLIC_AMAP_SECURITY_CODE="your-amap-security-code"
